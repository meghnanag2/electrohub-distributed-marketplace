# ─────────────────────────────────────────────────────────────────────────────
#  ElectroHub environment file
#
#  Copy to .env at the repo root before starting the stack:
#      cp .env.example .env
#
#  The variables marked REQUIRED have NO default in docker-compose.yml — the
#  stack refuses to start without them, on purpose. That is deliberate: the
#  old defaults ("password", "guest", "electrohub-dev-secret-...") were the
#  kind of value that quietly ships to production.
#
#  NEVER commit the real .env — only this template. .gitignore excludes it.
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED ────────────────────────────────────────────────────────────────

# Postgres superuser password (both shard0 and shard1 use the same one).
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Signs every JWT. Anyone holding this can forge a valid login token for any
# user, so it must be random and must never be shared between environments.
#   openssl rand -hex 32
JWT_SECRET_KEY=

# RabbitMQ credentials (AMQP on 5672, management UI on 15672). Do NOT use
# "guest": the official image allows guest to authenticate from any host, so
# a guest/guest broker is trivially takeoverable if the port is ever exposed.
RABBITMQ_USER=
RABBITMQ_PASSWORD=

# Grafana admin login (UI on 127.0.0.1:3001 — reach it via an SSH tunnel).
GRAFANA_ADMIN_PASSWORD=

# ── Cross-origin access ─────────────────────────────────────────────────────

# Comma-separated list of browser origins allowed to call the backend APIs.
# Read by user-service, listing-service, messaging-service, activity-service
# and recommendation-service.
#
# Local dev (frontend on CRA's dev server):
#   CORS_ORIGINS=http://localhost:3000
#
# Split deploy (frontend on Vercel, backend on a VM) — list every origin the
# app is actually served from, with scheme, no trailing slash. Vercel gives
# you a stable production URL plus a per-deployment preview URL; add whichever
# you will use. Preview URLs are per-commit and cannot be enumerated here.
#   CORS_ORIGINS=https://electrohub.vercel.app,https://www.example.com
CORS_ORIGINS=http://localhost:3000

# ── Optional: outbound email (notification-service) ─────────────────────────
# Leave blank to disable email sending — notification-service logs the
# notification instead of delivering it. Nothing else in the stack depends on
# these, so they are safe to skip for a first deploy.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Optional: TLS via docker-compose.prod.yml ───────────────────────────────
# Only used when you start the stack with `-f docker-compose.yml -f
# docker-compose.prod.yml` (see DEPLOY_PLAN.md). Caddy fetches a Let's Encrypt
# certificate for PUBLIC_DOMAIN, so it must be a real DNS name that already
# resolves to this machine's public IP — a bare IP address cannot get a cert.
PUBLIC_DOMAIN=
# Where Let's Encrypt sends expiry warnings.
ACME_EMAIL=

# ─────────────────────────────────────────────────────────────────────────────
#  NOT set here: the frontend's backend URL.
#
#  The React app reads REACT_APP_API_URL at BUILD time (Create React App
#  inlines it into the bundle), so it belongs to whatever builds the frontend,
#  not to this file:
#    - Vercel:    Project Settings → Environment Variables → REACT_APP_API_URL
#    - local:     frontend/.env.production
#  Value is the backend's public base URL with no trailing slash, e.g.
#    REACT_APP_API_URL=https://api.example.com
#  Leave it unset to get same-origin behaviour (local dev via the CRA proxy).
# ─────────────────────────────────────────────────────────────────────────────
